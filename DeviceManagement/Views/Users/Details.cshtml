@model DeviceManagement.Models.User
@{
    ViewData["Title"] = $"User Details - {Model.FullName}";
}

<div class="row justify-content-center mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-person-fill fs-3"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">@Model.FullName</h4>
                        <span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(Model.Department) ? "General Employee" : Model.Department)</span>
                    </div>
                </div>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil me-1"></i> Edit Profile
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Email Address</span>
                            <a href="mailto:@Model.Email" class="text-dark fw-bold text-decoration-none">
                                <i class="bi bi-envelope me-1 text-primary"></i>@Model.Email
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Phone Number</span>
                            <span class="fw-bold text-dark">
                                <i class="bi bi-telephone me-1 text-primary"></i>@Model.PhoneNumber
                            </span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-laptop me-2 text-primary"></i>Assigned Devices (@Model.Devices.Count)</h5>
                    <a asp-controller="Devices" asp-action="Create" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-circle me-1"></i> Assign New Device
                    </a>
                </div>

                <div class="table-responsive border rounded">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3">Device Code</th>
                                <th>Device Name</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Devices.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        No devices are currently assigned to this user.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var dev in Model.Devices)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <span class="badge bg-secondary font-monospace">@dev.Code</span>
                                        </td>
                                        <td class="fw-semibold">@dev.Name</td>
                                        <td>@dev.Category?.Name</td>
                                        <td>
                                            @if (dev.Status == DeviceManagement.Models.DeviceStatus.InUse)
                                            {
                                                <span class="badge badge-inuse">In use</span>
                                            }
                                            else if (dev.Status == DeviceManagement.Models.DeviceStatus.Broken)
                                            {
                                                <span class="badge badge-broken">Broken</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-maintenance">Maintenance</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <a asp-controller="Devices" asp-action="Details" asp-route-id="@dev.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Users
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
