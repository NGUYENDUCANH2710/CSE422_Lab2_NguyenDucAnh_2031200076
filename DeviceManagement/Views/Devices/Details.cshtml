@model DeviceManagement.Models.Device
@{
    ViewData["Title"] = $"Device Details - {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold mb-0"><i class="bi bi-info-circle text-primary me-2"></i>Device Details</h4>
                    <span class="text-muted">Information about @Model.Name</span>
                </div>
                <div>
                    <span class="badge bg-secondary font-monospace fs-6">@Model.Code</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Device Name</span>
                            <span class="fs-5 fw-bold text-dark">@Model.Name</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Category</span>
                            <span class="fs-5 fw-bold text-primary">@Model.Category?.Name</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Current Status</span>
                            @if (Model.Status == DeviceManagement.Models.DeviceStatus.InUse)
                            {
                                <span class="badge badge-inuse fs-6 mt-1"><i class="bi bi-check-circle me-1"></i>In use</span>
                            }
                            else if (Model.Status == DeviceManagement.Models.DeviceStatus.Broken)
                            {
                                <span class="badge badge-broken fs-6 mt-1"><i class="bi bi-x-circle me-1"></i>Broken</span>
                            }
                            else
                            {
                                <span class="badge badge-maintenance fs-6 mt-1"><i class="bi bi-wrench me-1"></i>Under maintenance</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Date of Entry</span>
                            <span class="fs-5 fw-semibold text-dark">@Model.EntryDate.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Assigned User / Employee</span>
                            @if (Model.User != null)
                            {
                                <div class="mt-1">
                                    <span class="fs-5 fw-bold text-dark"><i class="bi bi-person-badge text-primary me-2"></i>@Model.User.FullName</span>
                                    <span class="text-muted ms-3"><i class="bi bi-envelope me-1"></i>@Model.User.Email</span>
                                    <span class="text-muted ms-3"><i class="bi bi-telephone me-1"></i>@Model.User.PhoneNumber</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Currently unassigned (In storage / inventory)</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted small text-uppercase fw-semibold d-block">Description & Specifications</span>
                            <p class="mb-0 mt-1">@(string.IsNullOrEmpty(Model.Description) ? "No notes or specifications entered." : Model.Description)</p>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="bi bi-pencil me-1"></i> Edit Device
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            <i class="bi bi-trash me-1"></i> Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
