@model DeviceManagement.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Device Management Dashboard</h2>
        <p class="text-secondary mb-0">Overview of equipment, categories, active users, and health status.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-controller="Devices" asp-action="Create" class="btn btn-primary me-2 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add Device
        </a>
        <a asp-controller="Categories" asp-action="Create" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-tag me-1"></i> Add Category
        </a>
    </div>
</div>

<!-- Stat Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat border-0 shadow-sm bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold small">Total Devices</span>
                    <h3 class="fw-bold mt-2 mb-0">@Model.TotalDevices</h3>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                    <i class="bi bi-laptop fs-3"></i>
                </div>
            </div>
            <a asp-controller="Devices" asp-action="Index" class="stretched-link"></a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat border-0 shadow-sm bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold small">In Use</span>
                    <h3 class="fw-bold mt-2 mb-0 text-success">@Model.DevicesInUse</h3>
                </div>
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                    <i class="bi bi-check-circle fs-3"></i>
                </div>
            </div>
            <a asp-controller="Devices" asp-action="Index" asp-route-status="InUse" class="stretched-link"></a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat border-0 shadow-sm bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold small">Under Maintenance</span>
                    <h3 class="fw-bold mt-2 mb-0 text-warning">@Model.DevicesUnderMaintenance</h3>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                    <i class="bi bi-wrench-adjustable fs-3"></i>
                </div>
            </div>
            <a asp-controller="Devices" asp-action="Index" asp-route-status="UnderMaintenance" class="stretched-link"></a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat border-0 shadow-sm bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted text-uppercase fw-semibold small">Broken Devices</span>
                    <h3 class="fw-bold mt-2 mb-0 text-danger">@Model.DevicesBroken</h3>
                </div>
                <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle">
                    <i class="bi bi-exclamation-octagon fs-3"></i>
                </div>
            </div>
            <a asp-controller="Devices" asp-action="Index" asp-route-status="Broken" class="stretched-link"></a>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Category Distribution -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-pie-chart me-2 text-primary"></i>Devices by Category</h5>
                <a asp-controller="Categories" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All</a>
            </div>
            <div class="card-body pt-0">
                <ul class="list-group list-group-flush">
                    @foreach (var cat in Model.CategorySummaries)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-folder2 text-secondary"></i>
                                <span class="fw-medium">@cat.CategoryName</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light text-dark border px-2 py-1">@cat.DeviceCount devices</span>
                                <a asp-controller="Categories" asp-action="Devices" asp-route-id="@cat.CategoryId" class="btn btn-sm btn-outline-primary" title="View devices">
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Recent Devices -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Recently Registered Devices</h5>
                <a asp-controller="Devices" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All Devices</a>
            </div>
            <div class="card-body pt-0 p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Code / Name</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Assigned To</th>
                                <th class="text-end pe-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentDevices.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No devices recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var device in Model.RecentDevices)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <span class="badge bg-secondary font-monospace me-1">@device.Code</span>
                                            <div class="fw-semibold text-truncate" style="max-width: 180px;">@device.Name</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-info bg-opacity-10 text-dark">@device.Category?.Name</span>
                                        </td>
                                        <td>
                                            @if (device.Status == DeviceManagement.Models.DeviceStatus.InUse)
                                            {
                                                <span class="badge badge-inuse"><i class="bi bi-check-circle me-1"></i>In use</span>
                                            }
                                            else if (device.Status == DeviceManagement.Models.DeviceStatus.Broken)
                                            {
                                                <span class="badge badge-broken"><i class="bi bi-x-circle me-1"></i>Broken</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-maintenance"><i class="bi bi-wrench me-1"></i>Maintenance</span>
                                            }
                                        </td>
                                        <td>
                                            @(device.User?.FullName ?? "— Unassigned —")
                                        </td>
                                        <td class="text-end pe-3">
                                            <a asp-controller="Devices" asp-action="Details" asp-route-id="@device.Id" class="btn btn-sm btn-outline-secondary" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
